#!/bin/zsh

# 1. Ця магія визначає шлях до папки, де лежить цей самий скрипт, 
# і переходить у неї (навіть якщо ти запустив його з робочого столу)
cd "$(dirname "$0")"


# 2. Очищаємо екран для краси
clear
echo "========================================"
echo " 👾 Запуск Cyberdeck Daemon..."
echo "========================================"

# 3. Запускаємо нашого демона
/Users/admin/cli/py/venv/bin/python deck_daemon.py